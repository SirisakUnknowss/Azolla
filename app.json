{
  "expo": {
    "name": "Azolla",
    "slug": "azolla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "azolla",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f7f0",
    "primaryColor": "#237a45",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.azolla.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.azolla.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0a0e0b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Azolla",
      "shortName": "Azolla",
      "lang": "en",
      "themeColor": "#f4f7f0",
      "backgroundColor": "#f4f7f0",
      "description": "Conversation cards for people sitting across from each other.",
      "display": "standalone"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#f4f7f0"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/DeepTalk"
    }
  }
}
